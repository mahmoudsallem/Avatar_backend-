# Minimum-time profile for the Saytara avatar backend. UNTESTED on the GPU: run bench_speed.py first (see README of the steps below).
# Use:  cp .env .env.backup && cp recommended_fast.env .env   then restart the app.
#
# Idea: the model is distilled for ~4 steps. 2 candidates x 4 steps costs the same GPU time as 1 candidate x 8 steps,
# and the best-of-2 pick (identity score + visor check) usually beats a single 8-step image.

STEPS=4                    # 8 -> 4 halves the GPU time per try (fall back to 6 if bench_speed shows a visible drop)
CFG=1.0
REFINE_CFG=1.0

BEST_OF_N=2                # keep the identity-based pick between 2 candidates
ID_LORA_SCHEDULE=[1.0,1.1]
STOP_ID=0.55
TIME_BUDGET=0              # 0 = no wall-clock cut. Under load the old 45 s budget forced 1 try per avatar and hid the best-of-2 quality
VISOR_EXTRA_TRIES=1
MAX_GLASSES_FIXES=1

GPU_SLOTS=2
SLOT_MIN_FREE_GB=44
ANALYSIS_CONCURRENCY=4

# Output-identical speed-ups (no quality change):
CACHE_PROMPT_EMBEDS=true   # skips re-encoding the same prompt text; bit-identical
PERSISTENT_DETECT=true     # keeps the face-detect workers alive; removes the ~15 s CPU delay at the start of a burst

CORS_ORIGINS=["*"]
