# Fast-test settings for the Saytara avatar backend (distilled FLUX.2-klein-9B).
# On the server:  cp recommended.env .env   (keep your old file first:  cp .env .env.backup)
# then restart:   python app.py   (start it from this same folder)
# Compare quality on 10-20 photos with send_10_images.py before using in production.

# --- Speed: the distilled model is built for ~4 steps and guidance ~1.0 ---
STEPS=8
CFG=1.0
REFINE_CFG=1.0

# --- Fewer candidates per avatar, cap the worst case ---
BEST_OF_N=2
ID_LORA_SCHEDULE=[1.0,1.1]
STOP_ID=0.55
TIME_BUDGET=45
VISOR_EXTRA_TRIES=1
MAX_GLASSES_FIXES=1

# --- Concurrency: 2 slots is the safe maximum on a 96 GB card (each job peaks ~19 GB) ---
GPU_SLOTS=2
SLOT_MIN_FREE_GB=44
ANALYSIS_CONCURRENCY=4

# --- CORS: replace * with your front-end domain, e.g. ["https://app.example.com"] ---
CORS_ORIGINS=["*"]
