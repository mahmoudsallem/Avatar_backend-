# TensorRT fp16 speed test (apply on top of the current .env, then restart: python app.py)
# Needs: pip install torch-tensorrt (matching torch/CUDA), diffusers backend (NOT nunchaku).
# TensorRT compiles one fixed LoRA strength, so the LoRA is fused and the schedule must be uniform.
FLUX_BACKEND=diffusers
FUSE_LORA=true
ID_LORA_SCHEDULE=[1.0,1.0]
LORA_STRENGTH=1.0
COMPILE_TRANSFORMER=true
COMPILE_BACKEND=tensorrt
TRT_PRECISION=fp16
WARMUP_AT_STARTUP=true
