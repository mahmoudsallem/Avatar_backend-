# A/B test: nhathoangfoto/Flux.2-Klein-9B-SmartCharacterSwap instead of sisniha/BFS-Best-Face-Swap
# Use:  cp .env .env.backup && cp test_smartcharswap.env .env   (then restart: python app.py)
# Back to the old LoRA:  cp .env.backup .env
LORA=nhathoangfoto/Flux.2-Klein-9B-SmartCharacterSwap
LORA_FILE=Klein2-9B-SmartCharacterSwap.safetensors
LORA_TRIGGER=jhuangswap

# Model card: distilled = 4 steps, CFG 1.0, LoRA strength 0.85-1.0 | base = 20-30 steps, CFG 2-4, strength 0.75-1.0
LORA_STRENGTH=1.0
ID_LORA_SCHEDULE=[0.85,0.95,1.0]
FLUX_BACKEND=diffusers
STEPS=8
CFG=1.0
REFINE_CFG=1.0
