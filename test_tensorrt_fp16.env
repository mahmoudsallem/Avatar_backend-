# A/B test: TensorRT-compiled FLUX transformer in fp16 (torch.compile backend="tensorrt") instead of eager bf16.
# This path is already implemented in app/pipeline.py (apply_speed_options / _make_transformer_fp16) - it was
# just off by default. Needs: FLUX_BACKEND=diffusers (NOT nunchaku - TensorRT compile is unsupported there) and
# `pip install torch-tensorrt` matching the GPU box's torch/CUDA build.
# Use:  cp .env .env.backup && cp test_tensorrt_fp16.env .env   (then restart: python app.py)
# Back to the old path:  cp .env.backup .env
#
# First request per template shape (Man/Woman/Woman_Hijab) builds the TensorRT engine - slow (minutes).
# WARMUP_AT_STARTUP=true runs that build for all 3 shapes at startup instead of on the first live request,
# and pipeline.py already checks each fp16 warm-up image for a flat/black result (fp16 overflow) and logs an
# error telling you to fall back to TRT_PRECISION=bf16 if that happens. Engines are cached under
# TRT_ENGINE_CACHE_DIR and reused on the next start.
FLUX_BACKEND=diffusers

# TensorRT needs a static graph, so the LoRA must be fused into the weights at ONE fixed strength instead of
# the per-try escalating ID_LORA_SCHEDULE ([0.85,0.95,1.0]) the current profile uses for retries - that retry
# behaviour is traded away here for speed. [1.0,1.0] with the existing LORA_STRENGTH=0.7 keeps the same
# effective strength (0.7) as today's baseline try.
FUSE_LORA=true
ID_LORA_SCHEDULE=[1.0,1.0]

COMPILE_TRANSFORMER=true
COMPILE_BACKEND=tensorrt
TRT_PRECISION=fp16
TRT_ENGINE_CACHE_DIR=trt_cache
WARMUP_AT_STARTUP=true
