# ==============================================================================
# Saytara Avatar Generation Backend - Environment Configuration
# ==============================================================================

# ---------------- Server & Security ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ---------------- Output Encoding ----------------
# Final avatar is always re-encoded as JPEG and must not exceed this many bytes
# (quality is stepped down, then resolution, until it fits)
OUTPUT_MAX_BYTES=307200

# ---------------- Paths ----------------
# Relative paths resolve relative to Backend/
AVATAR_DIR=Avatar
CROP_DIR=crop
OUTPUT_DIR=output
REJECT_DIR=rejected

# ---------------- Model Identifiers ----------------
CLIP_MODEL=openai/clip-vit-base-patch32
FLUX_MODEL=black-forest-labs/FLUX.2-klein-9B
LORA=nhathoangfoto/Flux.2-Klein-9B-SmartCharacterSwap
LORA_FILE=Klein2-9B-SmartCharacterSwap.safetensors

# ---------------- Face Detection & Classification (Step 1) ----------------
FACE_DETECTOR=retinaface
MIN_FACE_CONFIDENCE=0.90
MIN_FACE_SIZE_PX=80
MAIN_FACE_DOMINANCE=2.5
CROP_SCALE=2.0

SCOPE_MIN_PERSON_SCORE=0.35
MIN_GENDER_CONFIDENCE=75.0
MIN_CLIP_GENDER_CONFIDENCE=0.75
GLASSES_POSITIVE_THRESHOLD=0.58
GLASSES_MIN_SCORE_MARGIN=0.08
BEARD_POSITIVE_THRESHOLD=0.56
BEARD_MIN_SCORE_MARGIN=0.05
HIJAB_POSITIVE_THRESHOLD=0.50
HIJAB_MIN_SCORE_MARGIN=0.00

# ---------------- Generation Settings ----------------
DETECT_BALD=true
BALD_POSITIVE_THRESHOLD=0.52
BALD_MIN_SCORE_MARGIN=0.03
BALD_FALLBACK_CLIP=0.80
BALD_STRONG_CLIP=0.90
BALD_SCALP_CLIP=0.65

# 2026-10-24: locked in round 61's architecture (CFG=1.0/REFINE_CFG=1.0/BEST_OF_N=1/
# LORA_STRENGTH=1.05) after manual review confirmed quality - 21.1 avatars/min, 2.85s/avatar,
# 14/14 ArcFace-passed (see evaluation_results/uat_round_61/report.html). Previous V2 sampler
# (CFG=3.0, BEST_OF_N=2) is archived below for revert.
# V2 sampler (archived): STEPS=3 / CFG=3.0 / REFINE_CFG=2.0 / LORA_STRENGTH=1.0 / BEST_OF_N=2
STEPS=3
CFG=1.0
REFINE_CFG=1.0
# LORA_STRENGTH=1.05: Restores full SmartCharacterSwap identity transfer so the avatar
# accurately reflects the user's facial geometry instead of fading into the template.
LORA_STRENGTH=1.05
SEED=42
HEAD_CROP_SCALE=1.6
REFINE_IDENTITY=true
REFINE_STRENGTH=0.85
FACE_CROP_SCALE=0.75
CLEAN_BG=true
LORA_SELFTEST=true
DEBUG_DUMP=false
VAE_TILING=false
FALLBACK_SCALE=1.15
HIJAB_SCALE=1.25
REF_SIZE=1024
STYLE_MODE=semi_real
KEEP_USER_EXPRESSION=true
# id_focus: identity instructions first in the prompt + explicitly keeps skin texture (pores,
# wrinkles, stubble) instead of airbrushing it away - the "tuned" default's style wording was
# erasing exactly the fine detail ArcFace needs for id_sim. See pipeline.py's IDENTITY_FOCUS.
PROMPT_VARIANT=id_focus

# ---------------- Output Validation (single-pass; off by default - ArcFace is unreliable on illustrated avatars) ----
VALIDATE=true
VALIDATE_AVATARS=["Man", "Woman", "Woman_Hijab"]
ID_PASS=0.40
JAW_TOL=0.15
BEARD_P=0.75
JAW_BEARD=0.25
VERIFY_MODEL=ArcFace
VERIFY_DETECTOR=retinaface
VERIFY_MAX_SIDE=512
WORKER_TIMEOUT=600

# ---------------- Glasses Validation ----------------
VALIDATE_GLASSES=true
VISOR_MIN_SCORE=0.38
DARK_FRAME_RATIO=1.3
MAX_GLASSES_FIXES=3
ADD_AVATAR_GLASSES=true
USER_GLASSES_MODE=avatar

# --- EC2 high-throughput production profile (1.5M daily scale) ---
# BEST_OF_N=1 (round 61 architecture, 2026-10-24): no retry escalation - a generation either
# clears ID_PASS on the first try or is rejected. Was 2 with ID_LORA_SCHEDULE escalation.
BEST_OF_N=1
TIME_BUDGET=0
ID_LORA_SCHEDULE=[1.0,1.1]
STOP_ID=0.40
VISOR_EXTRA_TRIES=0
MAX_GLASSES_FIXES=0
# GPU_SLOTS=4 (round 46): 5 was already proven worse (round 33) and crashed again this session
# at tighter memory margins than these - 4 is the verified-good slot count for this throughput level.
GPU_SLOTS=4
FLUX_BACKEND=nunchaku
NUNCHAKU_MODEL=tonera/FLUX.2-klein-9B-Nunchaku
FUSE_LORA=false
# COMPILE_TRANSFORMER=false (2026-10-24): tried nunchaku's compile_repeated_blocks() regional compile -
# fails cleanly on every slot ("['Flux2TransformerBlock', 'Flux2SingleTransformerBlock'] classes are not
# found in the model"). nunchaku's quantized blocks have different class names than the _repeated_blocks
# metadata it inherits from the unquantized base model - a gap in their current release, not our code.
# Falls back to uncompiled automatically (verified safe, zero production impact), but there's nothing to
# gain by leaving it on. Code stays in pipeline.py in case a future nunchaku release fixes this.
COMPILE_TRANSFORMER=false
SLOT_MIN_FREE_GB=44
# VAL_WORKERS=3 (2026-10-24): with BEST_OF_N=2, ArcFace scoring runs on every try now (not sampled -
# ARCFACE_SAMPLE_RATE only applies at BEST_OF_N=1), so GPU_SLOTS=4 can have up to 4 generations queuing
# for scoring workers at once. 2 was undersized for that - same class of bug as S3_MAX_CONCURRENT<GPU_SLOTS
# fixed earlier. DETECT_WORKERS dropped to 1 to stay within the 8-core budget (3+3+1=7, 1 free for
# orchestration - oversubscribing past 8 made things worse before, per e18b3a7). Zero accuracy impact -
# same ArcFace computation, just less queueing for it.
ANALYSIS_CONCURRENCY=3
VAL_WORKERS=3
PERSISTENT_DETECT=true
DETECT_WORKERS=1
CACHE_PROMPT_EMBEDS=true
CACHE_REF_LATENTS=true
ATTENTION_BACKEND=native
CUDNN_ENABLED=false

# ---------------- S3 Folder Watcher (Users/ -> Generated_Avatar/) ----------------
# Set S3_ENABLED=true to turn this on. AWS credentials come from the normal
# boto3 chain (env vars, ~/.aws/credentials, or the EC2 instance role) - no
# extra AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY needed here if one is already set.
S3_ENABLED=true
S3_BUCKET=avatar-etisalata
S3_USERS_PREFIX=Users/
S3_GENERATED_PREFIX=Generated_Avatar/
S3_REGION=us-east-1
S3_POLL_INTERVAL=1
S3_MAX_CONCURRENT=10
# S3_QUEUE_URL (2026-10-24): tried enabling real-time SQS mode, but the test (round 9108, 11.1/min)
# was confounded by the FA2 background build competing for CPU - couldn't get a clean read on its
# real effect. Reverted to polling (empty) to get back to the clean 13.0-13.2/min baseline (rounds
# 9105/9106). The queue/notification/IAM infra is still fully provisioned - just flip this back on
# (same value: https://sqs.us-east-1.amazonaws.com/752767404788/saytara-avatar-users-queue) once the
# build is done, for an uncontaminated comparison.
S3_QUEUE_URL=

# Model cache (install_models.py): separate bucket from S3_BUCKET above - mirrors the HF hub
# cache / DeepFace weights / local CLIP dir so a new instance doesn't re-download from
# Hugging Face / DeepFace.
S3_MODEL_BUCKET=saytara-models
S3_MODEL_CACHE_PREFIX=

# Hijab pixel post-fix OFF: it painted a flat taupe/pink patch over the chest. Without it (16-Oct 11:09 run)
# the model paints the neck drape in the user's own hijab colour.
HIJAB_POSTFIX=false

# OOM safety (added later). 15 so the 2nd slot that already ran before is not trimmed; OOM_RETRY retries a candidate once on CUDA OOM
SLOT_PEAK_GB=15
OOM_RETRY=true

# Test C: identity/speed ideas (BFS LoRA back; SCS on Nunchaku gave id_sim 0.391 < 0.412)
SCHED_SHIFT=1.5
VAE_COMPILE=false
# 2026-10-23: the trigger word / id_focus2 / LORA 1.2 boost made the likeness WORSE (user-verified) - reverted to id_focus, LORA_STRENGTH=1.05, no trigger.
ARCFACE_SAMPLE_RATE=1.0
# 2026-10-24: set back to 1.0 (full ArcFace coverage) for round 61's BEST_OF_N=1 architecture -
# app/pipeline.py's use_arcface only applies this sample rate when BEST_OF_N==1 (always-on when
# BEST_OF_N>1), so leaving this at 0.2 here would mean ~80% of avatars ship with NO identity
# check at all, which is not what round 61 actually ran (it predates this sampling optimization
# and had 100% ArcFace coverage). Revert to 0.2 only if BEST_OF_N goes back to >1 and CPU relief
# is needed again elsewhere.
# 2026-10-23 TEST: V2 sampler settings (CFG 3.0/2.0, LoRA 1.0, best-of-2 with LoRA 1.0 then 1.1). STEPS left at 3. Revert: archive/.env.before_v2_test
CLIP_PRIORITY_STREAM=true
# 2026-10-23: CLIP on a high-priority CUDA stream (Step 1 was 5x slower while the diffusion slots were busy). Output-neutral. Revert: set false.
