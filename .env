# ==============================================================================
# Saytara Avatar Generation Backend - Environment Configuration
# ==============================================================================

# ---------------- Server & Security ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ---------------- Output Encoding ----------------
# Final avatar is always re-encoded as JPEG and must not exceed this many bytes
# (quality is stepped down, then resolution, until it fits)
OUTPUT_MAX_BYTES=307200

# ---------------- Paths ----------------
# Relative paths resolve relative to Backend/
AVATAR_DIR=Avatar
CROP_DIR=crop
OUTPUT_DIR=output
REJECT_DIR=rejected

# ---------------- Model Identifiers ----------------
CLIP_MODEL=openai/clip-vit-base-patch32
FLUX_MODEL=black-forest-labs/FLUX.2-klein-9B
LORA=sisniha/BFS-Best-Face-Swap
LORA_FILE=bfs_head_v1_flux-klein_9b_step3500_rank128.safetensors

# ---------------- Face Detection & Classification (Step 1) ----------------
FACE_DETECTOR=retinaface
MIN_FACE_CONFIDENCE=0.90
MIN_FACE_SIZE_PX=80
MAIN_FACE_DOMINANCE=2.5
CROP_SCALE=2.0

SCOPE_MIN_PERSON_SCORE=0.35
MIN_GENDER_CONFIDENCE=75.0
MIN_CLIP_GENDER_CONFIDENCE=0.75
GLASSES_POSITIVE_THRESHOLD=0.58
GLASSES_MIN_SCORE_MARGIN=0.08
BEARD_POSITIVE_THRESHOLD=0.56
BEARD_MIN_SCORE_MARGIN=0.05
HIJAB_POSITIVE_THRESHOLD=0.50
HIJAB_MIN_SCORE_MARGIN=0.00

# ---------------- Generation Settings ----------------
DETECT_BALD=true
BALD_POSITIVE_THRESHOLD=0.52
BALD_MIN_SCORE_MARGIN=0.03
BALD_FALLBACK_CLIP=0.80
BALD_STRONG_CLIP=0.90
BALD_SCALP_CLIP=0.65

STEPS=8
CFG=1.0
REFINE_CFG=1.0
# 1.1 = the BFS face-swap LoRA at full effect. 0.3 (tried 16-Oct 17:06) let the template win: black hijab
# instead of the user's colour, closed template smile, lower id_sim (avg 0.364 -> 0.337). Keep 1.1.
LORA_STRENGTH=1.1
SEED=42
HEAD_CROP_SCALE=1.6
REFINE_IDENTITY=true
REFINE_STRENGTH=0.85
FACE_CROP_SCALE=0.75
CLEAN_BG=true
LORA_SELFTEST=true
DEBUG_DUMP=false
VAE_TILING=false
FALLBACK_SCALE=1.15
HIJAB_SCALE=1.25
REF_SIZE=1024
STYLE_MODE=semi_real
KEEP_USER_EXPRESSION=true
# id_focus: identity instructions first in the prompt + explicitly keeps skin texture (pores,
# wrinkles, stubble) instead of airbrushing it away - the "tuned" default's style wording was
# erasing exactly the fine detail ArcFace needs for id_sim. See pipeline.py's IDENTITY_FOCUS.
PROMPT_VARIANT=id_focus

# ---------------- Output Validation (single-pass; off by default - ArcFace is unreliable on illustrated avatars) ----
# VALIDATE=false (2026-10-23, throughput experiment): disables ArcFace identity scoring AND best-of-N
# (generate_avatar forces max_k=1 when this is off, see pipeline.py:2470). Ships every generation
# unscored - no identity-similarity gate, no visor/hair-mismatch retry. This removes the quality gate
# the uat_round_2 revert (33f68ba) was explicitly chosen to protect (100% acceptance). Re-enable before
# anything user-facing.
VALIDATE=true
VALIDATE_AVATARS=["Man", "Woman", "Woman_Hijab"]
ID_PASS=0.40
JAW_TOL=0.15
BEARD_P=0.75
JAW_BEARD=0.25
VERIFY_MODEL=ArcFace
VERIFY_DETECTOR=retinaface
VERIFY_MAX_SIDE=512
WORKER_TIMEOUT=600

# ---------------- Glasses Validation ----------------
VALIDATE_GLASSES=true
VISOR_MIN_SCORE=0.38
DARK_FRAME_RATIO=1.3
MAX_GLASSES_FIXES=3
ADD_AVATAR_GLASSES=true
USER_GLASSES_MODE=avatar

# --- EC2 high-throughput production profile (1.5M daily scale) ---
BEST_OF_N=3
TIME_BUDGET=0
ID_LORA_SCHEDULE=[1.0,1.1,1.2]
STOP_ID=0.55
VISOR_EXTRA_TRIES=2
MAX_GLASSES_FIXES=3
# GPU_SLOTS=5 (2026-10-23, throughput experiment): round 33 already tried 5 slots and found it made
# throughput WORSE, not better, plus cuDNN cublasLt crashes and a VAE_COMPILE deadlock (see 6de00e0,
# 066d961, 73880cc, d083c01) - all reverted back to 3 by 33f68ba. Watch nvidia-smi closely for OOM.
# FLUX_BACKEND=nunchaku (2026-10-23): forced back from "diffusers" - the diffusers backend needs
# the gated black-forest-labs/FLUX.2-klein-9B repo and no HF_TOKEN with accepted access is available
# right now (confirmed: no cached weights in the S3 model bucket either, only LICENSE.md/README.md).
# nunchaku pulls the ungated tonera/FLUX.2-klein-9B-Nunchaku mirror instead - no token needed, but it
# is quantized, which trades away this profile's "no quantization" MAX-IDENTITY intent. Switch back
# to "diffusers" once a valid, license-accepted HF token is set up (hf auth login / HF_TOKEN env var).
GPU_SLOTS=3
FLUX_BACKEND=nunchaku
NUNCHAKU_MODEL=tonera/FLUX.2-klein-9B-Nunchaku
FUSE_LORA=false
COMPILE_TRANSFORMER=false
# SLOT_MIN_FREE_GB=12 (2026-10-23): less headroom than the 35GB that already triggered OOM-trimming
# at GPU_SLOTS=5 before (d083c01 only went to 35, as a "user-authorized risk", and that wasn't enough).
SLOT_MIN_FREE_GB=44
ANALYSIS_CONCURRENCY=4
VAL_WORKERS=3
PERSISTENT_DETECT=true
DETECT_WORKERS=2
CACHE_PROMPT_EMBEDS=true
CACHE_REF_LATENTS=true
ATTENTION_BACKEND=native
CUDNN_ENABLED=false

# ---------------- S3 Folder Watcher (Users/ -> Generated_Avatar/) ----------------
# Set S3_ENABLED=true to turn this on. AWS credentials come from the normal
# boto3 chain (env vars, ~/.aws/credentials, or the EC2 instance role) - no
# extra AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY needed here if one is already set.
S3_ENABLED=true
S3_BUCKET=avatar-etisalata
S3_USERS_PREFIX=Users/
S3_GENERATED_PREFIX=Generated_Avatar/
S3_REGION=us-east-1
S3_POLL_INTERVAL=5
# S3_MAX_CONCURRENT must stay >= GPU_SLOTS, or GPU slots starve for S3-driven traffic (this exact
# bug was already fixed once in b571ee7 and silently reintroduced by the uat_round_2 revert).
S3_MAX_CONCURRENT=4

# Model cache (install_models.py): separate bucket from S3_BUCKET above - mirrors the HF hub
# cache / DeepFace weights / local CLIP dir so a new instance doesn't re-download from
# Hugging Face / DeepFace.
S3_MODEL_BUCKET=saytara-models
S3_MODEL_CACHE_PREFIX=

# Hijab pixel post-fix OFF: it painted a flat taupe/pink patch over the chest. Without it (16-Oct 11:09 run)
# the model paints the neck drape in the user's own hijab colour.
HIJAB_POSTFIX=false

# OOM safety (added later). 15 so the 2nd slot that already ran before is not trimmed; OOM_RETRY retries a candidate once on CUDA OOM
# SLOT_PEAK_GB=7 (2026-10-23): lower than the 10 that d083c01 already flagged as risky for a 5th slot.
# If real activation peaks exceed this, generation will OOM mid-run rather than being trimmed safely
# at startup - watch run.log for CUDA OutOfMemoryError if slot count drops after warmup.
SLOT_PEAK_GB=15
OOM_RETRY=true

# Test C: identity/speed ideas (BFS LoRA back; SCS on Nunchaku gave id_sim 0.391 < 0.412)
SCHED_SHIFT=1.5
VAE_COMPILE=false


MODEL_DTYPE=fp16
# MAX-IDENTITY profile (2026-10-23): face similarity first. ArcFace scoring + best-of-3 with rising LoRA strength, BFS LoRA @1.1, 8 steps, plain fp16 (no quantization). Previous throughput profile: archive/.env.before_max_identity
