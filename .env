# ==============================================================================
# Saytara Avatar Generation Backend - Optimized Production Configuration
# ==============================================================================

# ---------------- Server & Security ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ---------------- Output Encoding ----------------
OUTPUT_MAX_BYTES=307200

# ---------------- Paths ----------------
AVATAR_DIR=Avatar
CROP_DIR=crop
OUTPUT_DIR=output
REJECT_DIR=rejected

# ---------------- Model Identifiers ----------------
CLIP_MODEL=openai/clip-vit-base-patch32
FLUX_MODEL=black-forest-labs/FLUX.2-klein-9B
# Make sure LORA and LORA_TRIGGER match the exact model you want active:
LORA=nhathoangfoto/Flux.2-Klein-9B-SmartCharacterSwap
LORA_FILE=Klein2-9B-SmartCharacterSwap.safetensors
LORA_TRIGGER=ohwx person

# ---------------- Face Detection & Classification (Step 1) ----------------
FACE_DETECTOR=retinaface
MIN_FACE_CONFIDENCE=0.90
MIN_FACE_SIZE_PX=80
MAIN_FACE_DOMINANCE=2.5
CROP_SCALE=1.8

SCOPE_MIN_PERSON_SCORE=0.35
MIN_GENDER_CONFIDENCE=75.0
MIN_CLIP_GENDER_CONFIDENCE=0.75
GLASSES_POSITIVE_THRESHOLD=0.55
GLASSES_MIN_SCORE_MARGIN=0.08
BEARD_POSITIVE_THRESHOLD=0.52
BEARD_MIN_SCORE_MARGIN=0.05
HIJAB_POSITIVE_THRESHOLD=0.50
HIJAB_MIN_SCORE_MARGIN=0.00

# ---------------- Generation Settings ----------------
DETECT_BALD=true
BALD_POSITIVE_THRESHOLD=0.52
BALD_MIN_SCORE_MARGIN=0.03
BALD_FALLBACK_CLIP=0.80
BALD_STRONG_CLIP=0.90
BALD_SCALP_CLIP=0.65

# 4 steps + 1.15 shift gives proper structural convergence + pore detail for ArcFace
STEPS=4
CFG=1.0
REFINE_CFG=1.0
SCHED_SHIFT=1.15

# Unified LoRA weight across base and schedule
LORA_STRENGTH=1.0
ID_LORA_SCHEDULE=[1.0]

SEED=42
# Tighter head crop (1.35 vs 1.6) stops background clutter from bleeding into reference latents
HEAD_CROP_SCALE=1.35
FACE_CROP_SCALE=0.75
CLEAN_BG=true

# Lower refine strength (0.40 vs 0.85) preserves skull/face shape from pass 1 while sharpening skin/eyes
REFINE_IDENTITY=true
REFINE_STRENGTH=0.40

LORA_SELFTEST=true
DEBUG_DUMP=false
VAE_TILING=false
FALLBACK_SCALE=1.15
HIJAB_SCALE=1.25
REF_SIZE=1024
STYLE_MODE=semi_real
KEEP_USER_EXPRESSION=true
PROMPT_VARIANT=id_focus

# ---------------- Output Validation ----------------
VALIDATE=true
VALIDATE_AVATARS=["Man", "Woman", "Woman_Hijab"]
ID_PASS=0.42
STOP_ID=0.42
JAW_TOL=0.12
BEARD_P=0.75
JAW_BEARD=0.25
VERIFY_MODEL=ArcFace
VERIFY_DETECTOR=retinaface
VERIFY_MAX_SIDE=512
WORKER_TIMEOUT=600

# ---------------- Glasses Validation ----------------
VALIDATE_GLASSES=true
VISOR_MIN_SCORE=0.38
DARK_FRAME_RATIO=1.3
# Set USER_GLASSES_MODE=user if you want to keep real glasses on users with glasses,
# or keep ADD_AVATAR_GLASSES=false if you don't want the blue visor overriding real frames.
ADD_AVATAR_GLASSES=false
USER_GLASSES_MODE=user
MAX_GLASSES_FIXES=1
VISOR_EXTRA_TRIES=0

# --- EC2 High-Throughput Production Profile ---
BEST_OF_N=1
TIME_BUDGET=0
GPU_SLOTS=3
FLUX_BACKEND=nunchaku
NUNCHAKU_MODEL=tonera/FLUX.2-klein-9B-Nunchaku

# Fusing LoRA works when ID_LORA_SCHEDULE has a single static value [1.0] -> saves ~2s/img
# NOTE: only valid with FLUX_BACKEND=diffusers - Nunchaku requires FUSE_LORA=false
FUSE_LORA=false
COMPILE_TRANSFORMER=false
VAE_COMPILE=false

# Lowered from 44 to 16 so all 3 GPU slots actually load without being blocked by free-VRAM checks
SLOT_MIN_FREE_GB=16
SLOT_PEAK_GB=15
OOM_RETRY=true

ANALYSIS_CONCURRENCY=4
VAL_WORKERS=3
PERSISTENT_DETECT=true
DETECT_WORKERS=2
CACHE_PROMPT_EMBEDS=true
CACHE_REF_LATENTS=true
ATTENTION_BACKEND=flash_attn
CUDNN_ENABLED=true

# ---------------- S3 Folder Watcher ----------------
S3_ENABLED=true
S3_BUCKET=avatar-etisalata
S3_USERS_PREFIX=Users/
S3_GENERATED_PREFIX=Generated_Avatar/
S3_REGION=us-east-1
S3_POLL_INTERVAL=2
S3_MAX_CONCURRENT=3

S3_MODEL_BUCKET=saytara-models
S3_MODEL_CACHE_PREFIX=

HIJAB_POSTFIX=false