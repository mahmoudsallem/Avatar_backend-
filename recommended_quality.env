# Quality-first profile for the Saytara avatar backend. UNTESTED on the GPU - validate with the A/B matrix below first.
#
# Why: the notebook ("final version.ipynb", the quality reference) runs STEPS=20, CFG=3.0, BEST_OF_N=3 and
# ID_LORA_SCHEDULE=(1.0,1.1,1.2). The deployed .env runs STEPS=4 with CFG=3.0 and BEST_OF_N=2: 4 steps is the biggest
# drop in likeness/detail (outputs come out leaner, younger and with fuller hair than the real photo; id_sim 0.2-0.5).
# CFG>1 also runs the transformer twice per step, so STEPS=8/CFG=1.0 costs about the same GPU time as the current
# STEPS=4/CFG=3.0 - that pair is the first thing to compare.
#
# A/B on the EC2 box (same photos, same seeds). Needs ALLOW_TEST_OVERRIDES=true in .env, then restart:
#   python send_10_images.py --url http://localhost:8000 --matrix 4x2@3.0,8x2@1.0,12x2@1.0,20x3@3.0
#   python send_10_images.py --url http://localhost:8000 --matrix 8x2@1.0@semi_real,8x2@1.0@comic
# Open test_results/<run>/matrix_report.html and judge next to your reference avatars; the first token is the baseline.
# Pick the cheapest setting that looks like the references, then copy its values below into .env.

STEPS=8
CFG=1.0
REFINE_CFG=1.0
BEST_OF_N=3
ID_LORA_SCHEDULE=[1.0,1.1,1.2]
LORA_STRENGTH=1.1
STOP_ID=0.55
STYLE_MODE=semi_real
PROMPT_VARIANT=id_focus
KEEP_USER_EXPRESSION=true
TIME_BUDGET=0
VISOR_EXTRA_TRIES=2
MAX_GLASSES_FIXES=3

GPU_SLOTS=3
SLOT_MIN_FREE_GB=44
ANALYSIS_CONCURRENCY=4
CACHE_PROMPT_EMBEDS=true
CACHE_REF_LATENTS=true
PERSISTENT_DETECT=true
ATTENTION_BACKEND=native
