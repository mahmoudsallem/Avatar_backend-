# A/B TEST (not active): same sampler/prompt/LoRA as the current .env, but the UNQUANTIZED FLUX.2-klein-9B in fp16 on the plain diffusers backend.
# Only the backend differs, so any likeness difference vs the Nunchaku (4-bit) output is due to quantization.
# Environment variables override .env, so .env stays untouched. Run (stop or leave the Nunchaku server; this one uses port 8001 and does NOT read S3):
#   export HF_TOKEN=hf_xxx && python install_models.py install     # once: downloads the gated base model
#   set -a; source archive/test_diffusers_fp16.env; set +a; python app.py
#   then send photo #12 to http://localhost:8001 (send_10_images.py) and compare with image 2 + the gen= time in the log
PORT=8001
S3_ENABLED=false
FLUX_BACKEND=diffusers
MODEL_DTYPE=fp16
ATTENTION_BACKEND=native
FUSE_LORA=false
COMPILE_TRANSFORMER=false
GPU_SLOTS=2
SLOT_MIN_FREE_GB=30
SLOT_PEAK_GB=15
